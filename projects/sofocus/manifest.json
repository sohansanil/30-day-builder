{
  "manifest_version": 3,
  "name": "SoFocus",
  "version": "1.0.0",
  "description": "Turn watch time into knowledge. Capture the moments that matter without leaving the YouTube player.",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "SoFocus Knowledge Vault"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "commands": {
    "capture-insight": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Capture an insight at the current timestamp"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
